# ─────────────────────────────────────────────────────────────────────────────
# Beauté Halal — Dashboard d'administration
# Copiez ce fichier en « .env » puis adaptez.
#
# ⚠️ Ce fichier est lu AU MOMENT DU BUILD et son contenu est visible par toute
#    personne qui ouvre le dashboard. Il ne doit contenir AUCUN secret :
#    ni JWT_SECRET, ni mot de passe, ni identifiant de base de données.
#    Ces valeurs-là restent exclusivement dans le .env du backend.
# ─────────────────────────────────────────────────────────────────────────────

# Adresse de l'API Beauté Halal, préfixe « /api » inclus.
# C'est la MÊME API que celle du site public : même backend, même base.
VITE_API_URL=https://backend-beaute-halal.aeemci-ce.ci/api

# Pour développer contre l'API locale (backend lancé avec « npm run dev ») :
# VITE_API_URL=http://localhost:4000/api

# Adresse publique du site vitrine, pour le lien « Voir le site » de l'en-tête.
VITE_PUBLIC_SITE_URL=https://beaute-halal.aeemci-ce.ci
