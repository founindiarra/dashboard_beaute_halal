# Réécriture pour application monopage (Apache / cPanel / LiteSpeed).
# Sans ce fichier, un rafraîchissement sur /rendez-vous renvoie une 404 :
# le fichier n'existe pas sur le disque, c'est le routeur Vue qui gère l'adresse.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les fichiers et dossiers réellement présents sont servis normalement
  # (assets, favicon.svg, robots.txt, sitemap.xml…).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toute autre adresse est confiée à index.html, donc au routeur Vue.
  RewriteRule ^ index.html [L]
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# Cache — le point le plus délicat d'une application monopage.
#
# Les fichiers de « assets/ » portent une empreinte dans leur nom : leur contenu
# ne change jamais, on peut les garder un an.
#
# index.html, lui, est le seul fichier qui dit QUELS assets charger. S'il est
# mis en cache, ne serait-ce que quelques minutes, un visiteur peut recevoir un
# ancien index.html qui réclame des fichiers d'une version précédente. Les pages
# sont chargées à la demande : le fichier d'une page demandée après coup vient
# alors d'une autre version, le chargement échoue, et l'écran reste figé sur la
# page précédente — adresse déjà changée, contenu inchangé.
#
# D'où « no-store » et les trois en-têtes de compatibilité : certains caches
# intermédiaires ignorent l'un mais respectent les autres.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Espace d'administration : jamais indexé, jamais encadré dans un iframe.
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"

  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|avif)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

# Sur un hébergement LiteSpeed (très courant avec cPanel), le cache de pages
# entières se place AVANT Apache et ne lit pas les en-têtes ci-dessus. On le
# désactive : le seul document HTML du site pèse deux kilo-octets, il n'y a
# rien à gagner à le mettre en cache, et beaucoup à perdre.
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
